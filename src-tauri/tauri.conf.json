{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.2.3",
  "identifier": "com.pla0185.lumen",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumen",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Lumen",
    "copyright": "Copyright © 2026 Lumen",
    "category": "Productivity",
    "shortDescription": "Lumen —— 本地优先的智能任务管理",
    "longDescription": "本地优先的个人任务管理软件，支持复杂重复规则、提醒、悬浮今日小窗，可选接入大模型辅助整理、拆解、排程与复盘。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/PLA0185/lumen/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3MzdERTAzOEFCQUU1RjkKUldUNTVicUtBOTQzTjRibXFaT3Ara2ZKSXZwNkhXTEZqWnhhQXFyQWhtMnZVWTQ4UW5IRllmT20K",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
